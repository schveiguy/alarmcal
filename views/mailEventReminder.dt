html
  body
    - import alarmcal.formudas;
    - import alarmcal.dietutils;
    - import std.conv : to;
    h1 #{message}

    p
      | #{fieldNameToCapitals(event.type.to!string)} Event: #{event.title}
      br
      | Date: #{event.start.date.fullDatePrinter}
      br
      | Start: #{event.start.timeOfDay.timePrinter}
      br
      | End: #{event.end.timeOfDay.timePrinter}

    p You can manage your participation in the event here: #{hostname}

    - if(isAttending)
      p
        | Check in when you are the event by using the QR code at the location, or 
        a(href="#{hostname}/checkIn?askToConfirm=true&event_id=#{event.id}") this link
        | .

    p #{emailDisclaimer}
