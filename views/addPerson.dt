extends layout
block content
  include form
  h1 Add Person

  form(method="POST", action="/performAddPerson")
    section
      - import alarmcal.db;
      - createForm!Person();
    .form-group
      button(type="submit") Submit
      label
        input(type="checkbox", checked=true, name="sendInvite", value="true")
        |  Send Email Invitation
