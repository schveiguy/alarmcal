doctype html
html
  head
    title Password reset complete
    link(rel="stylesheet", href="/assets/css/alarmcal.css")
  body
    h1 Password reset successful!
    p Your password has been changed, #{candidate.name}. You can now #[a(href="/login") log in] with your new password.
    p
      i NOTE: All other active sessions for your account have been logged out for security.
