- import alarmcal.formudas;
- import alarmcal.dietutils;
- import sqlbuilder.uda;
- import std.traits;
- import std.datetime;
- import std.algorithm : canFind;
- import std.conv : to;
- void formFieldNum(T)(string name, string prefix, T defaultVal)
  input(type="number", value=defaultVal, name="#{prefix}#{name}")

- void formFieldString(string name, string prefix, string defaultVal)
  input(type="text", value=defaultVal, name="#{prefix}#{name}")

- void formFieldPassword(string name, string prefix, string defaultVal)
  input(type="password", name="#{prefix}#{name}", placeholder='#{defaultVal == null ? "" : "Leave blank to keep existing password"}')

- void formFieldEnum(T)(string name, string prefix, T defaultVal)
  select(name="#{prefix}#{name}")
    - static foreach(v; EnumMembers!T)
      option(value=v, selected=(defaultVal == v)) #{v}

- void formFieldDBEnum(T)(string name, string prefix, T[] options, long defaultVal)
  select(name="#{prefix}#{name}")
    - foreach(v; options)
      option(value=(v.id), selected=(defaultVal == v.id)) #{v.name}

- void formFieldDateTime(string name, string prefix, DateTime defaultVal)
  fieldset.datetime-group
    input(type="date", value=(defaultVal.date.datePrinter), name="#{prefix}#{name}_d")
    input(type="time", value=(defaultVal.timeOfDay), name="#{prefix}#{name}_t")

- void formFieldTimeOfDay(string name, string prefix, TimeOfDay defaultVal)
  input(type="time", value=(defaultVal), name="#{prefix}#{name}")

- void formFieldBool(string name, string prefix, bool defaultVal, string labelText)
  label
    input(type="checkbox", checked=defaultVal, name="#{prefix}#{name}", value="true")
    |  #{labelText}

- void formField(T)(string name, string prefix, T defaultVal, string labelText)
  div.form-group
    label #{labelText}
    - static if(is(T == enum))
      - formFieldEnum(name, prefix, defaultVal);
    - else static if(isNumeric!T)
      - formFieldNum(name, prefix, defaultVal);
    - else static if(is(T == string))
      - formFieldString(name, prefix, defaultVal);
    - else static if(is(T == DateTime))
      - formFieldDateTime(name, prefix, defaultVal);
    - else static if(is(T == TimeOfDay))
      - formFieldTimeOfDay(name, prefix, defaultVal);
    - else
      - static assert(false, "Unhandled field type: " ~ T.stringof);

- void createForm(T, string prefix="")(T defaultVal = T.init, string[] onlyThese = [])
  - static foreach(idx; 0 .. T.tupleof.length)
    - static if(!hasUDA!(T.tupleof[idx], autoIncrement) && !hasUDA!(T.tupleof[idx], noform))
      - if(onlyThese.length == 0 || onlyThese.canFind(__traits(identifier, T.tupleof[idx])))
        - static if(isIntegral!(typeof(T.tupleof[idx])) && hasUDA!(T.tupleof[idx], dbenum))
          .form-group
            label #{getFieldLabel!(T.tupleof[idx])}
            - formFieldDBEnum(__traits(identifier, T.tupleof[idx]), prefix, getDBEnumValues!(getUDAs!(T.tupleof[idx], dbenum)[0].Type), defaultVal.tupleof[idx]);
        - else static if(isSomeString!(typeof(T.tupleof[idx])) && hasUDA!(T.tupleof[idx], password))
          .form-group
            label #{getFieldLabel!(T.tupleof[idx])}
            - formFieldPassword(__traits(identifier, T.tupleof[idx]), prefix, defaultVal.tupleof[idx]);
        - else static if(is(typeof(T.tupleof[idx]) == bool))
          .form-group
            - formFieldBool(__traits(identifier, T.tupleof[idx]), prefix, defaultVal.tupleof[idx], getFieldLabel!(T.tupleof[idx]));
        - else static if(is(typeof(T.tupleof[idx]) == DateTime) && hasUDA!(T.tupleof[idx], timeOnly))
          - formField(__traits(identifier, T.tupleof[idx]), prefix, defaultVal.tupleof[idx].timeOfDay, getFieldLabel!(T.tupleof[idx]));
        - else
          - formField(__traits(identifier, T.tupleof[idx]), prefix, defaultVal.tupleof[idx], getFieldLabel!(T.tupleof[idx]));

//- Bulk editing: fields whose values differ among the items are left blank (or "various").

- bool allSame(T, F)(T[] items, scope F get)
  - foreach(i; items[1 .. $])
    - if(get(i) != get(items[0]))
      - return false;
  - return true;

- enum variousText = "Various, enter a value to set";

- void bulkFieldNum(T)(string name, string prefix, bool same, T val)
  input(type="number", value=(same ? val.to!string : ""), placeholder=(same ? "" : variousText), name="#{prefix}#{name}")

- void bulkFieldString(string name, string prefix, bool same, string val)
  input(type="text", value=(same ? val : ""), placeholder=(same ? "" : variousText), name="#{prefix}#{name}")

- void bulkFieldPassword(string name, string prefix)
  input(type="password", name="#{prefix}#{name}", placeholder="Leave blank to keep existing passwords")

- void bulkFieldEnum(T)(string name, string prefix, bool same, T val)
  select(name="#{prefix}#{name}")
    - if(!same)
      option(value="null", selected) (various)
    - static foreach(v; EnumMembers!T)
      option(value=v, selected=(same && val == v)) #{v}

- void bulkFieldDBEnum(T)(string name, string prefix, T[] options, bool same, long val)
  select(name="#{prefix}#{name}")
    - if(!same)
      option(value="null", selected) (various)
    - foreach(v; options)
      option(value=(v.id), selected=(same && val == v.id)) #{v.name}

- void bulkFieldDateTime(string name, string prefix, bool sameDate, bool sameTime, DateTime val)
  fieldset.datetime-group
    input(type="date", value=(sameDate ? val.date.datePrinter.to!string : ""), title=(sameDate ? "" : variousText), name="#{prefix}#{name}_d")
    input(type="time", value=(sameTime ? val.timeOfDay.to!string : ""), title=(sameTime ? "" : variousText), name="#{prefix}#{name}_t")
    - if(!sameDate || !sameTime)
      small.various-hint #{variousText}

- void bulkFieldTimeOfDay(string name, string prefix, bool same, TimeOfDay val)
  input(type="time", value=(same ? val.to!string : ""), title=(same ? "" : variousText), name="#{prefix}#{name}")
  - if(!same)
    small.various-hint #{variousText}

//- Tri-state boolean. The hidden input carries the submitted value: "null" (leave alone) until the
//- user touches the checkbox, then "true" or "false". See bulkFormScript.
- void bulkFieldBool(string name, string prefix, bool same, bool val, string labelText)
  label
    input.bulk-bool(type="checkbox", checked=(same && val), data-mixed=(same ? "false" : "true"))
    input(type="hidden", name="#{prefix}#{name}", value="null")
    |  #{labelText}

- void bulkFormScript()
  script.
    document.querySelectorAll('input.bulk-bool').forEach(function (c) {
      if (c.dataset.mixed == 'true') c.indeterminate = true;
      c.addEventListener('change', function () {
        c.indeterminate = false;
        c.nextElementSibling.value = c.checked ? 'true' : 'false';
      });
    });

- void createBulkForm(T, string prefix="")(T[] items, string[] onlyThese = [])
  - import std.conv : to;
  - static foreach(idx; 0 .. T.tupleof.length)
    - static if(!hasUDA!(T.tupleof[idx], autoIncrement) && !hasUDA!(T.tupleof[idx], noform))
      - if(onlyThese.length == 0 || onlyThese.canFind(__traits(identifier, T.tupleof[idx])))
        - alias FT = typeof(T.tupleof[idx]);
        - enum fname = __traits(identifier, T.tupleof[idx]);
        - enum flabel = getFieldLabel!(T.tupleof[idx]);
        - auto same = allSame(items, (T i) => i.tupleof[idx]);
        - static if(isIntegral!FT && hasUDA!(T.tupleof[idx], dbenum))
          .form-group
            label #{flabel}
            - bulkFieldDBEnum(fname, prefix, getDBEnumValues!(getUDAs!(T.tupleof[idx], dbenum)[0].Type), same, items[0].tupleof[idx]);
        - else static if(isSomeString!FT && hasUDA!(T.tupleof[idx], password))
          .form-group
            label #{flabel}
            - bulkFieldPassword(fname, prefix);
        - else static if(is(FT == bool))
          .form-group
            - bulkFieldBool(fname, prefix, same, items[0].tupleof[idx], flabel);
        - else static if(is(FT == DateTime) && hasUDA!(T.tupleof[idx], timeOnly))
          .form-group
            label #{flabel}
            - bulkFieldTimeOfDay(fname, prefix, allSame(items, (T i) => i.tupleof[idx].timeOfDay), items[0].tupleof[idx].timeOfDay);
        - else static if(is(FT == DateTime))
          .form-group
            label #{flabel}
            - bulkFieldDateTime(fname, prefix, allSame(items, (T i) => i.tupleof[idx].date), allSame(items, (T i) => i.tupleof[idx].timeOfDay), items[0].tupleof[idx]);
        - else static if(is(FT == enum))
          .form-group
            label #{flabel}
            - bulkFieldEnum(fname, prefix, same, items[0].tupleof[idx]);
        - else static if(isNumeric!FT)
          .form-group
            label #{flabel}
            - bulkFieldNum(fname, prefix, same, items[0].tupleof[idx]);
        - else static if(is(FT == string))
          .form-group
            label #{flabel}
            - bulkFieldString(fname, prefix, same, items[0].tupleof[idx]);
        - else
          - static assert(false, "Unhandled field type: " ~ FT.stringof);
  - bulkFormScript();
