html
  body
    - import alarmcal.formudas;
    - import alarmcal.dietutils;
    - import std.conv : to;
    h1 Upcoming Week's Events

    p Hello #{recipient.name}!

    p There are #{events.length} event(s) scheduled for the coming week. You are signed up for #{signedUpCount} of them.

    - foreach(we; events)
      p
        | #{fieldNameToCapitals(we.event.type.to!string)} Event: #{we.event.title}
        br
        | Date: #{we.event.start.date.fullDatePrinter}
        br
        | Start: #{we.event.start.timeOfDay.timePrinter}
        br
        | End: #{we.event.end.timeOfDay.timePrinter}
        - if(we.isSignedUp(recipient.id))
          br
          strong You are signed up for this event.

    p You can manage your participation in these events here: #{hostname}

    p #{emailDisclaimer}
