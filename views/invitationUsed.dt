extends layoutBasic
block title
  title Welcome to the team!
block content
  h1 Registration successful!
  p Thank you for registering, #{newUser.name}. Your account has been activated. To log in go to the #[a(href="/login") login page] and use the new password you created.
  p
    i NOTE: The invitation you used is not valid after one use. If you forget your password, use the reset password form on the login page.
