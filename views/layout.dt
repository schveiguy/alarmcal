doctype html
head
  title 4H Alarm Calendar
  meta(name="viewport", content="width=device-width, initial-scale=1")
  link(rel="stylesheet", href="/assets/css/alarmcal.css")
  block extraHead
body(data-admin=(currentUser.admin ? "true" : "false"))
  nav.top-bar
    a.admin_tool(href="/") Home
    - if(currentUser.admin)
      details.dropdown
        summary.admin_tool Admin tools
        div.dropdown-menu
          a(href="/persons") Persons
          a(href="/addPerson") Add Person
          a(href="/addEvent") Add Event
          a(href="/locations") Locations
          a(href="/addLocation") Add Location
    details.dropdown
      summary.admin_tool #{currentUser.name}
      div.dropdown-menu
        a(href="/editProfile") Edit Profile
        a(href="/logout") Logout
  script.
    document.addEventListener('click', function (e) {
      document.querySelectorAll('nav.top-bar details[open]').forEach(function (d) {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });
  block content

