extends layoutBasic
block title
  title 4H Alarm Calendar - Reset Password
block content
  h1 Reset your password
  p Hello, #{candidate.name.length > 0 ? candidate.name : candidate.email}. Enter a new password below.
  include form
  form(method="POST", action="/forgotpassword?id=#{candidate.reset_password_id}")
    section
      - createForm!Parameters();
    .form-group
      button(type="submit") Reset password
