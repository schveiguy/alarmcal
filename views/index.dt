extends layout
block extraHead
  script(src="/assets/js/eventpopup.js")
  script(src="/assets/js/autorefresh.js")
block content
  - import std.traits;
  form(action="/", method="GET", onchange="this.submit()")
    label(id="my_events")
      input(type="checkbox", name="my_events", checked=(model.params.my_events), value="true")
      |  My events
    select(name="style")
      - foreach(style; EnumMembers!(typeof(model.params.style)))
        option(value=(style), selected=(model.params.style == style)) #{style}
  h1 4H-Alarm Team 2079 Activity Calendar
  div#calendar-refresh(data-refresh-url="/calendarData")
    include calendarFragment
