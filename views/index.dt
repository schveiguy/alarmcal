extends layout
block extraHead
  script(src="/assets/js/eventpopup.js")
block content
  - import std.datetime;
  - import alarmcal.dietutils;
  - import alarmcal.db;
  - import std.traits;
  - import std.algorithm : map, any, count, joiner, canFind, filter;
  - import std.conv : to;
  - import std.format : format;
  - alias DisplayStyle = typeof(model.params.style);
  p Hello, #{currentUser.name}
  form(action="/", method="GET", onchange="this.submit()")
    label(id="my_events")
      input(type="checkbox", name="my_events", checked=(model.params.my_events), value="true")
      |  My events
    select(name="style")
      - foreach(style; EnumMembers!DisplayStyle)
        option(value=(style), selected=(model.params.style == style)) #{style}
  h1 4H-Alarm Team 2079 Activity Calendar
  - auto today = cast(Date)Clock.currTime();
  - auto myTodayEvents = model.cal.joiner.joiner.filter!(d => !d.isNull && d.get.date == today).map!(d => d.get.events.filter!(ev => ev.attendees.any!(att => att.person_id == currentUser.id))).joiner;
  - if (!myTodayEvents.empty)
    div#today-checkin
      h2 Check In for Today
      - foreach(ev; myTodayEvents)
        - auto myAtt = ev.attendees.filter!(att => att.person_id == currentUser.id);
        - bool checkedIn = !myAtt.empty && myAtt.front.attendanceRecorded;
        div.today-event
          | #{ev.event.title} (#{ev.event.start.timeOfDay.timePrinter} - #{ev.event.end.timeOfDay.timePrinter})
          - if (checkedIn)
            span.em-button.em-checked-in &#x2714; Checked in
          - else
            a.em-button.em-checkin(href="/checkIn?event_id=#{ev.event.id}") Check In
  - if(model.params.style == DisplayStyle.calendar)
    - foreach(mon; model.cal)
      table.cal_table
        tr
          th.month_title(colspan="7") #{monthNames[mon[0][$-1].get.date.month]} #{mon[0][$-1].get.date.year}
        tr
          th.day_title Sun
          th.day_title Mon
          th.day_title Tue
          th.day_title Wed
          th.day_title Thu
          th.day_title Fri
          th.day_title Sat
        - foreach(wr; mon)
          tr
            - foreach(d; wr)
              - if(d.isNull)
                td.unused_day_num &nbsp;
              - else
                td.day_num(class='#{d.get.date == today ? "today" : ""}') #{d.get.date.day}
          tr
            - foreach(d; wr)
              - if(d.isNull)
                td.unused_day &nbsp;
              - else
                td.day(class='#{d.get.date == today ? "today" : ""}')
                  - foreach(ev; d.get.events)
                    - bool imGoing = ev.attendees.any!(att => att.person_id == currentUser.id);
                    - auto locName = (ev.event.location_id in model.locations) ? model.locations[ev.event.location_id].name : "INVALID LOCATION";
                    - auto attsJson = ev.attendees.map!(att => attendeeJson(model.people[att.person_id].name, model.people[att.person_id].memberType.to!string, att.attendanceRecorded));
                    - auto calStudentCount = ev.attendees.map!(att => model.people[att.person_id].memberType).count(MemberType.student);
                    - auto calStudentsMaxed = ev.event.maxStudents > 0 && calStudentCount >= ev.event.maxStudents && currentUser.memberType == MemberType.student;
                    p(class="event-type-#{ev.event.type}")
                      - if (imGoing)
                        span.attending_check(title="You are attending") &check; 
                      | #{ev.event.title} (#{ev.event.start.timeOfDay.timePrinter} - #{ev.event.end.timeOfDay.timePrinter})
                      button.event-btn(data-event-id=(ev.event.id), data-title=(ev.event.title), data-type=(ev.event.type), data-location=(locName), data-start=(format("%s %s", ev.event.start.date.datePrinter, ev.event.start.timeOfDay.timePrinter)), data-end=(format("%s", ev.event.end.timeOfDay.timePrinter)), data-im-going=(imGoing ? "true" : "false"), data-attendees=(attsJson), data-is-past=(d.get.date < today ? "true" : "false"), data-students-maxed=(calStudentsMaxed ? "true" : "false"), data-min-students=(ev.event.minStudents), data-max-students=(ev.event.maxStudents), data-min-adults=(ev.event.minAdults)) &#x2139;
  - else
    - auto hasHiddenData = model.cal.joiner.joiner.canFind!(d => !d.isNull && d.get.events.length > 0 && d.get.date < today);
    - if (hasHiddenData)
      button#show-past &blacktriangleright; Show past events
    - foreach(mon; model.cal)
      - auto hideMonthTitle = mon[0][$-1].get.date.endOfMonth < today;
      h2(class='#{hideMonthTitle ? "hidden_data" : ""}') #{monthNames[mon[0][$-1].get.date.month]} #{mon[0][$-1].get.date.year}
      - foreach(wr; mon)
        - foreach(d; wr)
          - if(d.isNull || d.get.events.length == 0) continue;
          div.event_list_day(class='#{d.get.date < today ? "hidden_data" : ""}')
            h3
              | #{dayNames[d.get.date.dayOfWeek]} #{monthNames[d.get.date.month]} #{d.get.date.day}
              - if(d.get.date == today)
                |  (TODAY)
            - foreach(ev; d.get.events)
              - bool imGoing = ev.attendees.any!(att => att.person_id == currentUser.id);
              - auto locName = (ev.event.location_id in model.locations) ? model.locations[ev.event.location_id].name : "";
              - auto attsJson = ev.attendees.map!(att => attendeeJson(model.people[att.person_id].name, model.people[att.person_id].memberType.to!string, att.attendanceRecorded));
              - auto memberTypes = ev.attendees.map!(att => model.people[att.person_id].memberType);
              - auto studentCount = memberTypes.count(MemberType.student);
              - auto mentorCount = memberTypes.count(MemberType.mentor);
              - auto parentCount = memberTypes.count(MemberType.parent);
              - auto studentsSatisfied = studentCount >= ev.event.minStudents;
              - auto studentsMaxed = ev.event.maxStudents > 0 && studentCount >= ev.event.maxStudents && currentUser.memberType == MemberType.student;
              - auto adultsSatisfied = mentorCount + parentCount >= ev.event.minAdults;
              - auto mentorsSatisfied = mentorCount >= 1;
              p(class="event-type-#{ev.event.type}")
                - if (imGoing)
                  span.attending_check(title="You are attending") &check; 
                | #{ev.event.title} (#{ev.event.start.timeOfDay.timePrinter} - #{ev.event.end.timeOfDay.timePrinter})
              p.em-meta
                strong Type: 
                | #{ev.event.type}
              p.em-meta
                strong Location: 
                | #{locName}
              p.em-meta
                strong Student count: 
                | #{memberTypes.count(MemberType.student)} (min 
                span(class='#{studentsSatisfied ? "" : "low_count"}') #{ev.event.minStudents}
                - if (ev.event.maxStudents > 0)
                  | , max #{ev.event.maxStudents}
                | )
              p.em-meta
                strong Adult count: 
                span(class='#{mentorsSatisfied ? "" : "low_count"}') #{memberTypes.count(MemberType.mentor)}
                |  mentors, #{memberTypes.count(MemberType.parent)} parents (min 
                span(class='#{adultsSatisfied ? "" : "low_count"}') #{ev.event.minAdults}
                | )
              - if (ev.attendees.length == 0)
                p.em-meta
                  em No Attendees yet.
              - else
                div.em-attendees
                  h4 Attendees (#{ev.attendees.length})
                  ul
                    - foreach(att; ev.attendees)
                      - auto p = model.people[att.person_id];
                      li
                        | #{p.name} - #{p.memberType}
                        - if(att.attendanceRecorded)
                          em  (checked in)
                        - else if(d.get.date == today)
                          em  (not seen yet)
                        - else if(d.get.date < today)
                          em  (absent)
              div
                - if (d.get.date >= today)
                  - if (imGoing)
                    a.em-button.em-cancel-rsvp(href="/rsvp?event_id=#{ev.event.id}&attending=#{!imGoing}&style=#{model.params.style}") Cancel RSVP
                  - else if (studentsMaxed)
                    a.em-button.em-disabled(href="#") Full
                  - else
                    a.em-button.em-rsvp(href="/rsvp?event_id=#{ev.event.id}&attending=#{!imGoing}&style=#{model.params.style}") RSVP
                - if(currentUser.admin)
                  | &nbsp;
                  a.em-button.em-edit(href="/editEvent?id=#{ev.event.id}") Edit
                  | &nbsp;
                  a.em-button.em-delete(href="/deleteEvent?id=#{ev.event.id}") Delete
