html
  body
    h1 You are invited to join Alarm calendar!

    p Hello #{person.name.length > 0 ? person.name : person.email}!
    p You have been invited to join 4H Alarm Calendar. To finish creating your user, please click on the link below. Once you have created your user, this link will no longer work. If you find the link does not work, please contact the 4H Alarm mentor team to get your user reset.

    p
      a(href="#{hostname}/invite?id=#{person.invitation_id}") Accept Invitation

    p #{emailDisclaimer}
