- import std.datetime;
- import alarmcal.dietutils;
- import alarmcal.db;
- import alarmcal.app : getTime;
- import std.traits;
- import std.uri : encodeComponent;
- import std.algorithm : map, any, count, joiner, canFind, filter;
- import std.conv : to;
- import std.format : format;
- auto today = cast(Date)getTime();
- auto myTodayEvents = model.cal.joiner.joiner.filter!(d => !d.isNull && d.get.date == today).map!(d => d.get.events.filter!(ev => ev.attendees.any!(att => att.person_id == currentUser.id))).joiner;
- if (!myTodayEvents.empty)
  div#today-checkin
    h2 Check In for Today
    - foreach(ev; myTodayEvents)
      - auto myAtt = ev.attendees.filter!(att => att.person_id == currentUser.id);
      - bool checkedIn = !myAtt.empty && myAtt.front.attendanceRecorded;
      div.today-event
        | #{ev.event.title} (#{ev.event.start.timeOfDay.timePrinter} - #{ev.event.end.timeOfDay.timePrinter})
        - if (checkedIn)
          span.em-button.em-checked-in &#x2714; Checked in
        - else
          a.em-button.em-checkin(href="/checkIn?event_id=#{ev.event.id}") Check In
- if(model.params.style == typeof(model.params.style).calendar)
  - foreach(mon; model.cal)
    div.cal-table-wrap
      table.cal_table
        tr
          th.month_title(colspan="7") #{monthNames[mon[0][$-1].get.date.month]} #{mon[0][$-1].get.date.year}
        tr
          th.day_title Sun
          th.day_title Mon
          th.day_title Tue
          th.day_title Wed
          th.day_title Thu
          th.day_title Fri
          th.day_title Sat
        - foreach(wr; mon)
          tr
            - foreach(d; wr)
              - if(d.isNull)
                td.unused_day_num &nbsp;
              - else
                td.day_num(class='#{d.get.date == today ? "today" : ""}') #{d.get.date.day}
          tr
            - foreach(d; wr)
              - if(d.isNull)
                td.unused_day &nbsp;
              - else
                td.day(class='#{d.get.date == today ? "today" : ""}')
                  - foreach(ev; d.get.events)
                    - auto analysis = model.eventAnalysis(ev);
                    p(class="event-type-#{ev.event.type}")
                      - if (analysis.imGoing)
                        span.attending_check(title="You are attending") &check; 
                      - else if (analysis.iDeclined)
                        span.declined_mark(title="You have declined") &cross; 
                      | #{ev.event.title} (#{ev.event.start.timeOfDay.timePrinter} - #{ev.event.end.timeOfDay.timePrinter})
                      - if (ev.event.prospectsAllowed)
                        span.prospect-badge(title="Prospects allowed") P
                      button.event-btn(data-event-info=(model.eventJsonData(ev)), data-is-past=(d.get.date < today ? "true" : "false"), data-hide-people=(currentUser.prospect == true ? "true" : "false"))
                        svg.info-icon(viewBox="0 0 24 24", xmlns="http://www.w3.org/2000/svg", aria-hidden="true", focusable="false")
                          circle(cx="12", cy="5.3", r="2.0", fill="currentColor")
                          rect(x="10.2", y="9", width="3.6", height="9.4", fill="currentColor")
                          rect(x="8.7", y="8.4", width="5.1", height="1.5", rx="0.5", fill="currentColor")
                          rect(x="8.8", y="17.2", width="6.4", height="1.8", rx="0.6", fill="currentColor")
- else
  - auto hasHiddenData = model.cal.joiner.joiner.canFind!(d => !d.isNull && d.get.events.length > 0 && d.get.date < today);
  - if (hasHiddenData)
    button#show-past &blacktriangleright; Show past events
  - foreach(mon; model.cal)
    - auto hideMonthTitle = mon[0][$-1].get.date.endOfMonth < today;
    h2(class='#{hideMonthTitle ? "hidden_data" : ""}') #{monthNames[mon[0][$-1].get.date.month]} #{mon[0][$-1].get.date.year}
    - foreach(wr; mon)
      - foreach(d; wr)
        - if(d.isNull || d.get.events.length == 0) continue;
        div.event_list_day(class='#{d.get.date < today ? "hidden_data" : ""}')
          h3
            | #{dayNames[d.get.date.dayOfWeek]} #{monthNames[d.get.date.month]} #{d.get.date.day}
            - if(d.get.date == today)
              |  (TODAY)
          - foreach(ev; d.get.events)
            - auto analysis = model.eventAnalysis(ev);
            p(class="event-type-#{ev.event.type}")
              - if (analysis.imGoing)
                span.attending_check(title="You are attending") &check; 
              - else if (analysis.iDeclined)
                span.declined_mark(title="You have declined") &cross; 
              | #{ev.event.title} (#{ev.event.start.timeOfDay.timePrinter} - #{ev.event.end.timeOfDay.timePrinter})
              - if (ev.event.prospectsAllowed)
                span.prospect-badge(title="Prospects allowed") P
            p.em-meta
              strong Type: 
              | #{ev.event.type}
            p.em-meta
              strong Location:
              - if (analysis.locMapsUrl.length)
                a(href=(analysis.locMapsUrl), target="_blank", rel="noopener") #{analysis.locName}
              - else
                | #{analysis.locName}
            p.em-meta
              strong Student count: 
              | #{analysis.studentCount} (min 
              span(class='#{analysis.studentsSatisfied ? "" : "low_count"}') #{ev.event.minStudents}
              - if (ev.event.maxStudents > 0)
                | , max #{ev.event.maxStudents}
              | )
            p.em-meta
              strong Adult count: 
              span(class='#{analysis.mentorsSatisfied ? "" : "low_count"}') #{analysis.mentorCount}
              |  mentors, #{analysis.parentCount} parents (min 
              span(class='#{analysis.adultsSatisfied ? "" : "low_count"}') #{ev.event.minAdults}
              | )
            - if (analysis.attendeeCount == 0)
              p.em-meta
                em No Attendees yet.
            - else if (currentUser.prospect)
              p.em-meta
                em #{analysis.attendeeCount} attending
            - else
              div.em-attendees
                h4 Attendees (#{analysis.attendeeCount})
                ul
                  - foreach(att; ev.attendees)
                    - auto p = model.people[att.person_id];
                    li
                      | #{p.name} - #{p.memberType}
                      - if(att.attendanceRecorded)
                        em  &check;
                      - else if(d.get.date == today)
                        em  (not seen yet)
                      - else if(d.get.date < today)
                        em  (absent)
            - if (ev.declined.length > 0 && !currentUser.prospect)
              div.em-declined
                h4 Declined (#{ev.declined.length})
                ul
                  - foreach(att; ev.declined)
                    - auto p = model.people[att.person_id];
                    li #{p.name} - #{p.memberType}
            div
              - if (d.get.date >= today)
                - if (analysis.imGoing)
                  em You are attending this event.&nbsp;
                  a.em-button.em-decline(href="/rsvp?event_id=#{ev.event.id}&response=declined&style=#{model.params.style}") Decline Instead
                  | &nbsp;
                  a.em-button.em-withdraw(href="/rsvp?event_id=#{ev.event.id}&response=none&style=#{model.params.style}") Remove Response
                - else if (analysis.iDeclined)
                  em You have declined this event.&nbsp;
                  a.em-button.em-attend(href="/rsvp?event_id=#{ev.event.id}&response=attending&style=#{model.params.style}") Attend Instead
                  | &nbsp;
                  a.em-button.em-withdraw(href="/rsvp?event_id=#{ev.event.id}&response=none&style=#{model.params.style}") Remove Response
                - else
                  - if (analysis.studentsMaxxed)
                    a.em-button.em-disabled(href="#") Full
                  - else
                    a.em-button.em-rsvp(href="/rsvp?event_id=#{ev.event.id}&response=attending&style=#{model.params.style}") Attend
                  | &nbsp;
                  a.em-button.em-decline(href="/rsvp?event_id=#{ev.event.id}&response=declined&style=#{model.params.style}") Decline
              - if(currentUser.admin)
                | &nbsp;
                a.em-button.em-edit(href="/editEvent?id=#{ev.event.id}") Edit
                | &nbsp;
                a.em-button.em-delete(href="/deleteEvent?id=#{ev.event.id}") Delete
